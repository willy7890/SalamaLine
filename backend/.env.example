# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0
API_PREFIX=api/v1
FRONTEND_ORIGINS=http://localhost:5173
# Set true when running behind nginx/a load balancer so rate limits use the real client IP.
TRUST_PROXY=false
SWAGGER_ENABLED=true

# ── Data stores ─────────────────────────────────────────
DATABASE_URL=postgresql://salamaline:salamaline_dev_password@localhost:5432/salamaline?schema=public
# Optional in development (in-memory fallback). REQUIRED in production.
REDIS_URL=redis://localhost:6379

# ── Secrets (generate with: npm run gen:keys) ────────────
JWT_ACCESS_SECRET=replace-me-with-64-hex-chars-from-gen-keys-aaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_ACCESS_TTL=15m
BCRYPT_ROUNDS=12
# HMAC pepper for phone-number hashes. MUST differ from JWT_ACCESS_SECRET. Never rotate casually (hashes change).
CONTACT_HASH_SECRET=replace-me-with-another-64-hex-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# AES-256-GCM key for callback numbers: base64 of exactly 32 random bytes.
CONTACT_ENC_KEY=
CONTACT_ENC_KEY_VERSION=1
# Optional: previous key kept only so old ciphertexts can still be decrypted during rotation.
CONTACT_ENC_KEY_PREVIOUS=
CONTACT_ENC_KEY_PREVIOUS_VERSION=

# ── Staff ───────────────────────────────────────────────
# The only account that may grant ADMIN. Set to YOUR address; used by `npm run seed`.
SUPER_ADMIN_EMAIL=
# Used only by `npm run seed` (not read by the app). Pass on the command line; do NOT store here.
# SEED_ADMIN_PASSWORD=

# ── Messaging providers ─────────────────────────────────
# SMS_PROVIDER: disabled | fake | africastalking     (fake is refused in production)
SMS_PROVIDER=fake
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_BASE_URL=https://api.sandbox.africastalking.com
# WHATSAPP_PROVIDER: disabled | fake | cloud
WHATSAPP_PROVIDER=disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Shared secret the SMS/USSD gateway must send (header x-webhook-secret or ?token=). >= 24 chars.
WEBHOOK_SHARED_SECRET=
# Optional comma-separated gateway IPs. If set, other source IPs are rejected.
WEBHOOK_IP_ALLOWLIST=

# ── Safeguarding / operations ───────────────────────────
# Shown first on a low wellbeing check-in. Put the real, verified helpline number.
HELPLINE_NUMBER=
ESCALATION_REMINDER_MINUTES=10
ESCALATION_REMINDERS_BEFORE_FOCAL=2
CONTACT_MAX_RETENTION_DAYS=30
SMALL_COUNT_THRESHOLD=5

# ── Staff security / retention ──────────────────────────
# Staff 2FA (TOTP). Unset = required in production, optional elsewhere. Cannot be disabled in production.
# REQUIRE_MFA_STAFF=true
MFA_ISSUER=SalamaLine
# Audit events older than this are deleted (min 90). Decide the policy with your safeguarding lead.
AUDIT_RETENTION_DAYS=730
